---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  pageTitle="anna cano"
  title="Anna Cano | Software Engineer in Barcelona"
>
  <div class="page-container">
    <div class="image-container"></div>
    <div class="text-container">
      <h2>Full Stack Developer</h2>
      <p>
        Passionate about writing clean code, Test-Driven Development, building
        efficient systems, collaborating in agile environments and design.
      </p>
      <div class="info-container">
        <button class="button">
          <a href="/AnnaCano_2026_CV.pdf" download>Download CV</a>
        </button>
        <div class="icon-text-container">
          <svg class="icon-container"></svg>
          <p>Based in Barcelona</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 2em;
    padding: 2em 15em 5em 15em;
    flex-wrap: wrap;
    margin-bottom: 9em;
  }

  .image-container {
    background: url("../assets/icons/me.svg") no-repeat center center;
    background-size: contain;
    width: 100%;
    max-width: 312px;
    aspect-ratio: 1;
    flex-shrink: 0;
    background-color: var(--primary);
    image-rendering: pixelated;
    animation:
      rise 0.6s ease-out both,
      float 2s ease-in-out 0.6s infinite;
    transition: box-shadow 0.15s ease-in-out;
  }

  .image-container:hover {
    box-shadow: 10px 10px 0 var(--tertiary);
  }

  :global(.dark-theme .image-container) {
    background-color: var(--primary);
    box-shadow: 6px 6px 0 var(--tertiary);
  }

  :global(.light-theme .image-container) {
    background-color: var(--secondary);
    box-shadow: 6px 6px 0 var(--tertiary);
  }

  .text-container {
    font-size: 2.2em;
    line-height: 1.5;
    flex: 1;
    min-width: 300px;
  }

  /* Staggered entrance for the text block */
  .text-container > * {
    animation: rise 0.6s ease-out both;
    animation-delay: calc(var(--i, 0) * 0.12s + 0.2s);
  }

  h2 {
    --i: 0;
  }

  .text-container > p {
    --i: 1;
  }

  .info-container {
    --i: 2;
  }

  .info-container {
    display: flex;
    justify-content: flex-start;
    gap: 0.5em;
    padding: 2rem 0rem;
  }

  .icon-text-container {
    width: 60%;
    display: flex;
    align-items: center;
  }

  a {
    text-decoration: none;
  }

  .icon-container {
    background: url("../assets/icons/location.svg") no-repeat center center;
    background-size: contain;
    max-width: 1.875rem;
    max-height: 1.875rem;
    aspect-ratio: 1;
    flex-shrink: 0;
    margin: 0.5rem;
    animation: bob 1.6s ease-in-out infinite;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  @keyframes float {
    50% {
      transform: translateY(-8px);
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes bob {
    50% {
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .image-container,
    .text-container > *,
    h2::after,
    .icon-container {
      animation: none;
    }
  }

  @media (max-width: 800px) {
    .info-container {
      padding: 1rem;
      justify-content: space-evenly;
    }

    .page-container {
      flex-direction: column;
      padding: 2em;
    }

    .image-container {
      max-width: 312px;
    }

    h2,
    p {
      text-align: center;
    }
  }

  @media (max-width: 500px) {
    .text-container {
      font-size: 2.2em;
      line-height: 1.5;
      flex: 1;
      min-width: none;
    }

    .info-container {
      width: 100%;
      flex-direction: column;
      padding: 1rem;
      justify-content: space-evenly;
    }

    .icon-text-container {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-evenly;
    }

    .page-container {
      flex-wrap: nowrap;
      flex-direction: column;
      padding: 2em;
    }

    .image-container {
      max-width: 312px;
    }

    h2,
    p {
      text-align: center;
    }
  }

  @media (min-width: 700px) {
    .page-container {
      margin-bottom: 2em;
    }
  }
</style>
