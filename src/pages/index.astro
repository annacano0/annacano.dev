---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="anna cano">
  <div class="page-container">
    <div class="image-container"></div>
    <div class="text-container">
      <h2>Full Stack Developer</h2>
      <p>
        Passionate about writing clean code, building efficient systems,
        collaborating in agile environments and art!
      </p>
      <div class="info-container">
        <button class="button">
          <a href="/AnnaCano_2026_CV.pdf" download>Download CV</a>
        </button>
        <div class="icon-text-container">
          <svg class="icon-container"></svg>
          <p>Based in Barcelona</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 2em;
    padding: 2em 15em 5em 15em;
    flex-wrap: wrap;
    margin-bottom: 2em;
  }

  .image-container {
    background: url("../assets/icons/me.svg") no-repeat center center;
    background-size: contain;
    width: 100%;
    max-width: 250px;
    aspect-ratio: 1;
    flex-shrink: 0;
    background-color: var(--tertiary);
  }

  :global(.dark-theme .image-container) {
    background-color: var(--primary);
    box-shadow: 5px 5px 0 var(--tertiary);
  }

  :global(.light-theme .image-container) {
    background-color: var(--secondary);
    box-shadow: 5px 5px 0 var(--tertiary);
  }

  .text-container {
    font-size: 1.75em;
    line-height: 1.5;
    flex: 1;
    min-width: 300px;
  }

  .info-container {
    display: flex;
    justify-content: flex-start;
    gap: 0.5em;
    padding: 2rem 0rem;
  }

  .icon-text-container {
    width: 60%;
    display: flex;
    align-items: center;
  }

  a {
    text-decoration: none;
  }

  .icon-container {
    background: url("../assets/icons/location.svg") no-repeat center center;
    background-size: contain;
    max-width: 1.5rem;
    max-height: 1.5rem;
    aspect-ratio: 1;
    flex-shrink: 0;
    margin: 0.5rem;
  }

  @media (max-width: 800px) {
    .info-container {
      padding: 1rem;
      justify-content: space-evenly;
    }

    .page-container {
      flex-direction: column;
      padding: 2em;
    }

    .image-container {
      max-width: 250px;
    }

    h2,
    p {
      text-align: center;
    }
  }

  @media (max-width: 500px) {
    .text-container {
      font-size: 1.75em;
      line-height: 1.5;
      flex: 1;
      min-width: none;
    }

    .info-container {
      width: 100%;
      flex-direction: column;
      padding: 1rem;
      justify-content: space-evenly;
    }

    .icon-text-container {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-evenly;
    }

    .page-container {
      flex-wrap: nowrap;
      flex-direction: column;
      padding: 2em;
    }

    .image-container {
      max-width: 250px;
    }

    h2,
    p {
      text-align: center;
    }
  }
</style>
