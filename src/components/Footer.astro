<div class="footer">
  <div class="footer-content">
    <p class="logo">
      created by: <a
        href="https://github.com/annacano0/annacano.dev"
        target="_blank">annacano0</a
      >
    </p>
    <div class="socials">
      <a
        class="icon"
        href="https://www.linkedin.com/in/anna-cano-palacios/"
        target="_blank">in</a
      >
      <a class="icon" href="https://github.com/annacano0" target="_blank">Gh</a>
    </div>
  </div>
</div>
<style>
  .footer {
    width: 100%;
    background-color: var(--background);
    position: fixed;
    bottom: 0;
    display: flex;
    justify-content: center;
    padding-bottom: env(safe-area-inset-bottom);
  }

  .footer-content {
    width: 90%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5em;
    border-top: 2px solid var(--color-1);
    padding: 0.5em 1em;
    box-sizing: border-box;
  }

  .logo {
    margin: 0;
    font-size: 1em;
    text-align: center;
  }

  .socials {
    display: flex;
    gap: 0.75em;
  }

  .socials .icon {
    font-size: 1em;
    padding: 0.2em 0.6em;
    min-width: 2.75em;
    min-height: 2.75em;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 700px) {
    .footer-content {
      width: 90%;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 0.5em 3em;
    }

    .logo {
      font-size: 1.875em;
      text-align: left;
    }

    .socials .icon {
      font-size: 1.5em;
      min-width: 0;
      min-height: 0;
      padding: 0.25em 0.625em;
    }
  }
</style>
